      "checkConstraints": {
        "occurrences_price_valid": {
          "name": "occurrences_price_valid",
          "value": "(\"events\".\"occurrences\".\"price_kind\" IS DISTINCT FROM 'paid'\n          AND \"events\".\"occurrences\".\"price_from\" IS NULL AND \"events\".\"occurrences\".\"price_to\" IS NULL AND \"events\".\"occurrences\".\"price_currency\" IS NULL)\n        OR (\"events\".\"occurrences\".\"price_kind\" = 'paid'\n          AND \"events\".\"occurrences\".\"price_from\" IS NOT NULL AND \"events\".\"occurrences\".\"price_from\" >= 0 AND \"events\".\"occurrences\".\"price_currency\" IS NOT DISTINCT FROM 'PLN'\n          AND (\"events\".\"occurrences\".\"price_to\" IS NULL OR \"events\".\"occurrences\".\"price_to\" >= \"events\".\"occurrences\".\"price_from\"))"
        }
