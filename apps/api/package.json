{
  "name": "@events/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --import ./src/observability/telemetry.ts src/server.ts",
    "start": "tsx --env-file-if-exists=.env --import ./src/observability/telemetry.ts src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=.env src/runSeed.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@events/contract": "workspace:*",
    "@events/repo": "workspace:*",
    "@events/time": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/instrumentation-pg": "0.77.0",
    "@opentelemetry/instrumentation-pino": "0.70.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1",
    "pino": "10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@events/eslint-config": "workspace:*",
    "@events/typescript-config": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
